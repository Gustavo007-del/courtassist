{
  "expo": {
    "name": "Court Assist",
    "slug": "court-assist",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "courtassist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.courtassist.advocate",
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#12263A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "in.courtassist.advocate",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Allow Court Assist to capture private legal documents.", "recordAudioAndroid": false }],
      "expo-sharing",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      "expo-notifications",
      ["expo-local-authentication", { "faceIDPermission": "Allow Court Assist to use Face ID to unlock the app." }],
      ["expo-image-picker", { "photosPermission": "Allow Court Assist to select a private profile image or signature.", "cameraPermission": "Allow Court Assist to take a private profile image or signature.", "microphonePermission": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12263A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
