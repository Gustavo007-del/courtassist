APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://courtassist:replace_me@localhost:5432/courtassist
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:8081
TRUSTED_HOSTS=
REQUEST_MAX_BYTES=8388608
REQUEST_BODY_TIMEOUT=20
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESET_URL_BASE=
PRIVATE_STORAGE_DIR=./private_uploads
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=auto
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_URL_SECONDS=300
CLAMAV_HOST=
CLAMAV_PORT=3310
OCR_PROVIDER=disabled

# Phase 13: disabled until configured; keep admin credentials server-side only.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# First key encrypts; comma-separated previous keys permit rotation.
NOTIFICATION_TOKEN_KEYS=
NOTIFICATION_MAX_ATTEMPTS=5

# Phase 14. AI is optional and disabled until configured on the server and by the advocate.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=
AI_MODEL=
AI_EMBEDDING_URL=
AI_EMBEDDING_MODEL=
AI_API_KEY=
AI_EXTERNAL=true
AI_EXTERNAL_NO_TRAINING_VERIFIED=false
AI_PROVIDER_POLICY=
AI_TIMEOUT_SECONDS=40
AI_REQUESTS_PER_MINUTE=4
AI_REQUESTS_PER_DAY=20
AI_MAX_SOURCE_CHARS=60000
# AI_INPUT_COST_PER_MILLION=0.0
# AI_OUTPUT_COST_PER_MILLION=0.0
