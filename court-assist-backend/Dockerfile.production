FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tesseract-ocr tesseract-ocr-eng tesseract-ocr-mal && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 10001 courtassist && useradd -u 10001 -g 10001 -M courtassist
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
 && install -d -m 0700 -o courtassist -g courtassist /app/private_uploads
COPY app ./app
COPY migrations ./migrations
COPY ops/probe.py ./ops/probe.py
COPY alembic.ini .
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-access-log", "--limit-concurrency", "64", "--timeout-keep-alive", "5", "--timeout-graceful-shutdown", "25"]

